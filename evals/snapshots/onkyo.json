{
  "commit": "69d8153661adc4f776cc830d3651dee599d9db1a",
  "instructions": "Controls Onkyo/Integra AV receivers on the local network. In the home theater signal chain, the Onkyo AV Receiver acts as the Audio Switcher and Master Volume Owner: media sources (such as NVIDIA Shield TV) feed into AVR HDMI inputs (e.g. 'strm-box'), and the AVR routes video out to the display (LG webOS TV) while powering speakers directly. Always adjust volume here via onkyo_set_volume rather than on the display. Call onkyo_get_status first: it shows each receiver's zones (main, zone2, zone3) with power, volume, mute, and input. Pass `receiver` when multiple units are present, and `zone` for secondary rooms. Each receiver features one hardware network streaming player, shared by every zone whose input is 'net'.",
  "package": "onkyo_mcp",
  "server": "onkyo",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "\n<use_case>\nSend transport playback commands (play, pause, stop, next, previous) to the network player.\n</use_case>\n<important_notes>\n- Controls the single shared network media player.\n- \"play\" resumes paused media; use `onkyo_play_station` to launch new stations.\n- Track skip availability is contingent on service rules (e.g., Pandora hourly skip quotas).\n</important_notes>\n",
      "inputSchema": {
        "properties": {
          "action": {
            "enum": [
              "play",
              "pause",
              "stop",
              "next",
              "previous"
            ],
            "title": "Action",
            "type": "string"
          },
          "receiver": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Which receiver: its name or IP address. Omit when there is only one; with several, a call without it is refused rather than guessed.",
            "title": "Receiver"
          }
        },
        "required": [
          "action"
        ],
        "title": "onkyo_control_playbackArguments",
        "type": "object"
      },
      "name": "onkyo_control_playback",
      "outputSchema": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "done",
              "dry_run"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "receiver": {
            "title": "Receiver",
            "type": "string"
          },
          "sent": {
            "items": {
              "type": "string"
            },
            "title": "Sent",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "zone": {
            "anyOf": [
              {
                "enum": [
                  "main",
                  "zone2",
                  "zone3"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone"
          }
        },
        "required": [
          "receiver",
          "zone",
          "outcome",
          "detail",
          "sent",
          "warnings"
        ],
        "title": "ActionResult",
        "type": "object"
      }
    },
