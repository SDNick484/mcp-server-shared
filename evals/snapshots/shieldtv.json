      "description": "List the Shield's Bluetooth remotes (e.g. a Harmony hub) and whether each works.\n\n<use_case>\nDiagnose unresponsive physical or hub remotes paired to the Shield over Bluetooth.\n</use_case>\n\n<important_notes>\n- Requires ADB connection (`mcp-server-shieldtv adb-setup`).\n- Reports \"stuck\" state when a connected remote stops sending button events (common after sleep/reboot).\n</important_notes>\n",
      "inputSchema": {
        "properties": {},
        "title": "shield_get_remotesArguments",
        "type": "object"
      },
      "name": "shield_get_remotes",
      "outputSchema": {
        "$defs": {
          "Remote": {
            "properties": {
              "address": {
                "title": "Address",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "state": {
                "enum": [
                  "working",
                  "stuck",
                  "connecting",
                  "disconnected"
                ],
                "title": "State",
                "type": "string"
              }
            },
            "required": [
              "name",
              "address",
              "state"
            ],
            "title": "Remote",
            "type": "object"
          }
        },
        "properties": {
          "advice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advice"
          },
          "remotes": {
            "items": {
              "$ref": "#/$defs/Remote"
            },
            "title": "Remotes",
            "type": "array"
          }
        },
        "required": [
          "remotes",
          "advice"
        ],
        "title": "RemotesReport",
        "type": "object"
      }
    },
