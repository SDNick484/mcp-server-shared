              },
              "name": {
                "title": "Name",
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "title": "ActivityRef",
            "type": "object"
          },
          "SleepTimerEnd": {
            "description": "How the last sleep timer ended. Nothing can tell the model when a timer fires, so this is where it looks.",
            "properties": {
              "at": {
                "title": "At",
                "type": "string"
              },
              "detail": {
                "title": "Detail",
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "fired",
                  "cancelled",
                  "failed"
                ],
                "title": "Outcome",
                "type": "string"
              }
            },
            "required": [
              "outcome",
              "detail",
              "at"
            ],
            "title": "SleepTimerEnd",
            "type": "object"
          },
          "SleepTimerInfo": {
            "description": "A pending sleep timer. Lives in this server's memory only (see HubClient.set_sleep_timer).",
            "properties": {
              "fires_at": {
                "title": "Fires At",
                "type": "string"
              },
              "minutes_left": {
                "title": "Minutes Left",
                "type": "integer"
              },
              "retrying": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Retrying"
              }
            },
            "required": [
              "fires_at",
              "minutes_left",
              "retrying"
            ],
            "title": "SleepTimerInfo",
            "type": "object"
          },
          "Status": {
            "properties": {
              "current_activity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ActivityRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "firmware": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Firmware"
              },
              "host": {
                "title": "Host",
                "type": "string"
              },
              "hub": {
                "title": "Hub",
                "type": "string"
              },
              "last_sleep_timer": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SleepTimerEnd"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "power": {
                "anyOf": [
                  {
                    "enum": [
                      "on",
                      "off"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Power"
              },
              "reachable": {
                "title": "Reachable",
                "type": "boolean"
              },
              "sleep_timer": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SleepTimerInfo"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transition": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Transition"
              }
            },
            "required": [
              "hub",
              "host",
              "reachable",
              "firmware",
              "power",
              "current_activity",
              "transition",
              "sleep_timer",
              "last_sleep_timer"
            ],
            "title": "Status",
            "type": "object"
          }
        },
        "properties": {
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "hint": {
            "title": "Hint",
            "type": "string"
          },
          "hubs": {
            "items": {
              "$ref": "#/$defs/Status"
            },
            "title": "Hubs",
