      "description": "Run a hub's power-off, turning off every device in its running activity.\n\nWith no hub and several hubs on, this asks which; hub='all' turns off every one and reports each hub\nseparately (one unreachable hub doesn't stop the others).\n\nforce=True is for a hub stuck mid-sequence (harmony_get_status shows a transition that never clears): it sends\nthe power off anyway. Use it only after a normal harmony_power_off was refused as busy. Without hub it acts on\nhubs that are on or mid-sequence; to force one that reports off, name it.\n",
      "inputSchema": {
        "properties": {
          "force": {
            "default": false,
            "description": "Force power-off even if an activity sequence is in progress.",
            "title": "Force",
            "type": "boolean"
          },
          "hub": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hub name, or 'all' for every hub. Omit when only one hub is on.",
            "title": "Hub"
          }
        },
