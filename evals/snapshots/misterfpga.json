        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "\n<use_case>\nCreate a timestamped local backup of game saves and save states from the MiSTer.\n</use_case>\n<important_notes>\n- Rate-limited to prevent SD card and network IOPS exhaustion.\n- Uses hard links for unchanged files to save disk space.\n- Requires configured backup_dir and SSH connectivity.\n</important_notes>\n",
      "inputSchema": {
        "properties": {
          "dry_run": {
            "default": false,
            "description": "Count what would be copied, write nothing.",
            "title": "Dry Run",
            "type": "boolean"
          },
          "host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "MiSTer name from mister_get_status. Omit when the call already says which (a ref does).",
            "title": "Host"
          }
        },
        "title": "mister_backup_savesArguments",
        "type": "object"
      },
      "name": "mister_backup_saves",
      "outputSchema": {
        "properties": {
          "bytes_copied": {
            "title": "Bytes Copied",
            "type": "integer"
          },
          "copied": {
            "title": "Copied",
            "type": "integer"
          },
          "files": {
            "title": "Files",
            "type": "integer"
          },
          "host": {
            "title": "Host",
            "type": "string"
          },
          "linked": {
            "title": "Linked",
            "type": "integer"
          },
          "outcome": {
            "enum": [
              "done",
              "dry_run"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "pruned": {
            "title": "Pruned",
            "type": "integer"
          },
          "snapshot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot"
          }
        },
        "required": [
          "host",
          "outcome",
          "snapshot",
          "files",
          "copied",
          "linked",
          "bytes_copied",
          "pruned"
        ],
        "title": "BackupInfo",
        "type": "object"
      }
    },
