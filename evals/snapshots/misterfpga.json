      "description": "\n<use_case>\nLaunch a game via ref or open a core without media on a MiSTer FPGA.\n</use_case>\n<important_notes>\n- Refuses to launch while another game is active; call mister_return_to_menu first.\n- Rate-limited to prevent rapid FPGA bitstream reconfiguration cycling.\n- Signals game start to Pixelcade marquees and MQTT play tracking.\n</important_notes>\n",
      "inputSchema": {
        "properties": {
          "game": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A game ref from mister_search_games or mister_play_history, e.g. 'Family Room/4812'.",
            "title": "Game"
          },
          "host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "MiSTer name from mister_get_status. Omit when the call already says which (a ref does).",
            "title": "Host"
          },
          "system": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Instead of a game: a system id from mister_list_systems, to open its core with no game.",
            "title": "System"
          }
        },
        "title": "mister_launchArguments",
        "type": "object"
      },
      "name": "mister_launch",
      "outputSchema": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "host": {
            "title": "Host",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "done",
              "unchanged",
              "dry_run"
            ],
            "title": "Outcome",
