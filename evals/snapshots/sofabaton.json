              },
              "device_id": {
                "title": "Device Id",
                "type": "integer"
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Label"
              },
              "press_type": {
                "title": "Press Type",
                "type": "string"
              },
              "received_at": {
                "title": "Received At",
                "type": "string"
              },
              "seq": {
                "title": "Seq",
                "type": "integer"
              },
              "transport": {
                "title": "Transport",
                "type": "string"
              }
            },
            "required": [
              "seq",
              "device_id",
              "command_id",
              "label",
              "press_type",
              "transport",
              "received_at"
            ],
            "title": "Press",
            "type": "object"
          }
        },
        "properties": {
          "expired": {
            "title": "Expired",
            "type": "boolean"
          },
          "instance_id": {
            "title": "Instance Id",
            "type": "string"
          },
          "last_seq": {
