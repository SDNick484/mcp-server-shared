    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "What each hub's activity changed from and to, and when (newest first, or oldest first with after_seq).\n\nAnswers \"what was on at 9 last night?\", \"how long was the office TV on?\" and \"was it turned on from the\nremote?\". Each change has from_activity and to_activity (null means everything off), previous_lasted_seconds\n(how long the previous state lasted), and source: 'this_server' for a start or power off this server sent,\n'elsewhere' for anything else (the physical remote, the Harmony app, Home Assistant): the hub can't say which.\nA recording_started event is where this server began watching a hub, not a change. Nothing is recorded while\nthe server isn't running, so a time before recording_since, or between one session's last event and the next\nrecording_started, is \"not recorded\", not \"nothing happened\". noticed_late means the change was found after\na reconnect, so `at` is when it was noticed, not when it happened.\n",
      "inputSchema": {
        "properties": {
          "after_seq": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only events newer than this seq (from a previous call's last_seq).",
            "title": "After Seq"
          },
          "hub": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hub name from harmony_get_status. Omit to look across all hubs (needed only if a name repeats).",
            "title": "Hub"
          },
          "limit": {
            "default": 20,
            "description": "Most events to return, 1-100.",
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "harmony_get_historyArguments",
        "type": "object"
      },
      "name": "harmony_get_history",
      "outputSchema": {
        "$defs": {
          "HistoryEvent": {
            "properties": {
              "at": {
                "title": "At",
                "type": "string"
              },
              "from_activity": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "From Activity"
              },
              "hub": {
                "title": "Hub",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "change",
                  "recording_started"
                ],
                "title": "Kind",
                "type": "string"
              },
              "noticed_late": {
                "title": "Noticed Late",
                "type": "boolean"
              },
              "previous_lasted_at_least": {
                "title": "Previous Lasted At Least",
                "type": "boolean"
              },
              "previous_lasted_seconds": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Previous Lasted Seconds"
              },
              "seq": {
                "title": "Seq",
                "type": "integer"
              },
              "source": {
                "anyOf": [
                  {
                    "enum": [
                      "this_server",
                      "elsewhere"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Source"
              },
              "to_activity": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "To Activity"
              }
            },
            "required": [
              "seq",
              "at",
              "hub",
              "kind",
              "from_activity",
              "to_activity",
              "source",
              "noticed_late",
              "previous_lasted_seconds",
              "previous_lasted_at_least"
            ],
            "title": "HistoryEvent",
            "type": "object"
          }
        },
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "events": {
            "items": {
              "$ref": "#/$defs/HistoryEvent"
            },
            "title": "Events",
            "type": "array"
          },
          "expired": {
            "title": "Expired",
            "type": "boolean"
          },
          "hint": {
            "title": "Hint",
            "type": "string"
          },
          "last_seq": {
            "title": "Last Seq",
            "type": "integer"
          },
          "persisted": {
            "title": "Persisted",
            "type": "boolean"
          },
          "recording_since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recording Since"
          },
          "session_started": {
            "title": "Session Started",
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "persisted",
          "session_started",
          "recording_since",
          "last_seq",
          "expired",
          "events"
        ],
        "title": "HistoryPage",
        "type": "object"
      }
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Start here. Lists every hub (one per TV) with whether it's reachable, on or off, and its running activity.\n\ntransition is non-null while an activity is starting or powering off; that hub's commands wait until it\nclears. dry_run true means this server reports writes instead of sending them.\n\nsleep_timer is a pending harmony_set_sleep_timer (when it fires, minutes left) or null. last_sleep_timer says how\nthe previous one ended (fired, cancelled or failed, and why): nothing else tells you when a timer fires, so\ncheck here after the time has passed.\n",
      "inputSchema": {
        "properties": {},
        "title": "harmony_get_statusArguments",
        "type": "object"
      },
      "name": "harmony_get_status",
      "outputSchema": {
        "$defs": {
          "ActivityRef": {
            "properties": {
              "id": {
