      "description": "\n<use_case>\nSearch the cabinet's game catalog by title, system, genre, player count, or play history.\n</use_case>\n<important_notes>\n- Returns matches with 32-character game_id needed for batocera_launch_game and batocera_get_game.\n- Supports filtering by genre and players (case-insensitive substring); use offset to page past limit.\n- Supports sorting by relevance, name, most_played, most_time, recently_played, or random.\n</important_notes>\n",
      "inputSchema": {
        "properties": {
          "favorites_only": {
            "default": false,
            "title": "Favorites Only",
            "type": "boolean"
          },
          "genre": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by genre substring, e.g. 'Fighting', 'Platform'.",
            "title": "Genre"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Skip the first N matching games for pagination.",
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "players": {
            "anyOf": [
              {
                "maxLength": 10,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by player string or count, e.g. '2', '1-2'.",
            "title": "Players"
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Words from the game's name, e.g. 'mario world'.",
            "title": "Query"
          },
          "sort": {
            "default": "relevance",
            "description": "relevance (best name match first), by name, play count, play time or last played, or random (a shuffled pick of the matches).",
            "enum": [
              "relevance",
              "name",
              "most_played",
              "most_time",
              "recently_played",
              "random"
            ],
            "title": "Sort",
            "type": "string"
          },
          "system": {
