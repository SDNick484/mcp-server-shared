            "description": "Command name or label from harmony_list_commands, e.g. 'VolumeUp'.",
            "title": "Command",
            "type": "string"
          },
          "delay_ms": {
            "anyOf": [
              {
                "maximum": 2000,
                "minimum": 100,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Pause between repeats (default 400 ms).",
            "title": "Delay Ms"
          },
          "device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Send straight to this device (name or ref). Omit to send through the running activity.",
            "title": "Device"
          },
          "hold_ms": {
            "default": 0,
            "description": "Hold each press this long (a long press). 0 is a tap.",
            "maximum": 3000,
            "minimum": 0,
