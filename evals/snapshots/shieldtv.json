              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App"
          },
          "app_package": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Package"
          },
          "position_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position S"
          },
          "state": {
            "enum": [
              "playing",
              "paused",
              "buffering",
              "stopped",
              "other",
              "idle"
            ],
            "title": "State",
            "type": "string"
          },
          "subtitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitle"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "state",
          "app_package",
          "app",
          "title",
          "subtitle",
          "position_s"
        ],
        "title": "NowPlaying",
        "type": "object"
      }
    },
    {
