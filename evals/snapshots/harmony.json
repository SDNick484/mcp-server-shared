    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Turn a hub's TV system off in `minutes` minutes (the same power-off as harmony_power_off); 0 cancels.\n\n\"Turn the bedroom TV off in 45 minutes\" is one call. A new timer replaces the one already set on that hub.\nWith no hub and several hubs on, this asks which. A hub that is off is refused.\n\nThe timer is held in this server's memory, not on the hub, and is not saved: under `serve --http` it outlives\nthe chat, but over stdio the server exits when the MCP client closes, and the timer goes with it. It is\ndropped if the hub is powered off first (by anyone); switching activities keeps it. If the hub is busy or\nunreachable when it fires, it retries for a few minutes, then gives up. Nothing notifies you when it fires:\ncheck harmony_get_status (sleep_timer while pending, last_sleep_timer afterwards).\n",
      "inputSchema": {
        "properties": {
          "hub": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hub name from harmony_get_status. Omit when only one hub is on.",
            "title": "Hub"
          },
          "minutes": {
            "description": "Minutes from now, 1-720. 0 cancels the timer.",
            "maximum": 720,
            "minimum": 0,
            "title": "Minutes",
            "type": "integer"
          }
        },
        "required": [
          "minutes"
        ],
        "title": "harmony_set_sleep_timerArguments",
        "type": "object"
      },
      "name": "harmony_set_sleep_timer",
      "outputSchema": {
        "$defs": {
          "SleepTimerInfo": {
            "description": "A pending sleep timer. Lives in this server's memory only (see HubClient.set_sleep_timer).",
            "properties": {
              "fires_at": {
                "title": "Fires At",
                "type": "string"
              },
              "minutes_left": {
                "title": "Minutes Left",
                "type": "integer"
              },
              "retrying": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Retrying"
              }
            },
            "required": [
              "fires_at",
              "minutes_left",
              "retrying"
            ],
            "title": "SleepTimerInfo",
            "type": "object"
          }
        },
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "hub": {
            "title": "Hub",
            "type": "string"
          },
          "outcome": {
