{
  "commit": "1e8beb1694e8d30ae3c97b9352d652b2068e5a6b",
  "instructions": "Controls a Sofabaton universal remote hub (X1, X1S or X2). Call sofabaton_get_status first: it gives the hub's model, the running activity, and `capabilities` and `limitations` for this hub, so you know what will work. Prefer activities: sofabaton_start_activity powers the right devices; sofabaton_power_off turns the running activity off. sofabaton_press_button sends a remote button (VOL_UP, PAUSE, ...) through the running activity; sofabaton_send_command sends a named macro, favorite or device command. MQTT features (live activity state, control while the Sofabaton app is open) exist only on the X2; on an X1/X1S, close the Sofabaton app if commands are refused.",
  "package": "sofabaton_mcp",
  "server": "sofabaton",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Make the physical remote beep so it can be found. Through sofabaton-x-server (any model), or on an X2\nwithout a server, directly over the hub's own protocol (SOFABATON_HUB_IP), which works only while the Sofabaton\napp is closed. The direct path has no confirmation: ask the user whether they hear it.\n",
      "inputSchema": {
        "properties": {},
        "title": "sofabaton_find_remoteArguments",
        "type": "object"
      },
      "name": "sofabaton_find_remote",
      "outputSchema": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "done",
              "unchanged",
              "dry_run"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "sent": {
            "items": {
              "type": "string"
            },
            "title": "Sent",
            "type": "array"
          },
          "via": {
            "enum": [
              "server",
              "mqtt",
              "direct"
            ],
            "title": "Via",
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "detail",
          "via",
          "sent"
        ],
        "title": "ActionResult",
        "type": "object"
      }
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Recent presses of remote keys bound to a Wifi Device on the hub (newest first, or oldest first with\nafter_seq). Lets a button on the remote ask for something. Comes from sofabaton-x-server's log (any model),\nor on an X2 over MQTT. If instance_id changes, the log restarted and older seqs are gone.\n",
      "inputSchema": {
        "properties": {
          "after_seq": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only presses newer than this seq (from a previous call's last_seq).",
            "title": "After Seq"
          },
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "sofabaton_get_recent_pressesArguments",
        "type": "object"
      },
      "name": "sofabaton_get_recent_presses",
      "outputSchema": {
