{
  "commit": "172c44d76d3c9b63ccf52b92f798aa02998a7d95",
  "instructions": "Controls Logitech Harmony Hubs, usually one per TV. Call harmony_get_status first: it lists each hub by name, whether it is on, and its running activity. Prefer activities: harmony_start_activity (e.g. 'Watch Shield') powers the right devices and switches inputs; harmony_power_off turns a hub's devices off. For buttons, harmony_send_command without a device goes through the running activity. Names can be hub-qualified ('Den/Watch TV', the `ref` field of list results); pass hub only when a name exists on several hubs.",
  "package": "harmony_mcp",
  "server": "harmony",
  "tools": [
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "What an activity sets up, read from the hub's config; sends nothing.\n\nLists each device it involves with its expected power (on, off or unknown) and input, and which device\neach group of buttons goes to (e.g. Volume to the receiver). expected_state 'unknown' means the hub's\nconfig doesn't say: report it as unknown, don't guess. Useful to rebuild an activity on another remote.\n",
      "inputSchema": {
        "properties": {
          "activity": {
            "description": "Activity name or ref from harmony_list_activities, e.g. 'Den/Watch TV'.",
            "title": "Activity",
            "type": "string"
          },
          "hub": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hub name from harmony_get_status. Omit to look across all hubs (needed only if a name repeats).",
            "title": "Hub"
          }
        },
        "required": [
          "activity"
        ],
        "title": "harmony_describe_activityArguments",
        "type": "object"
      },
