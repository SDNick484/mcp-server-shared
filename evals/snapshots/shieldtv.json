{
  "commit": "a5b8739b5ea6973f8b359f2575ae8db3f86570a6",
  "instructions": "Physical role: Media Source. Connects into Onkyo AVR input 'strm-box' (which routes video downstream to the TV display and plays master audio). Controls an NVIDIA Shield TV over the Android TV Remote protocol. Call shield_get_status first to see whether it is on and what app is in the foreground, and shield_get_now_playing for the title and play state. The Shield must have been paired once with `mcp-server-shieldtv pair`.",
  "package": "shieldtv_mcp",
  "server": "shieldtv",
  "tools": [
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Report what is playing: app, title, subtitle (artist or channel), play state, position in seconds.\n\n<use_case>\nRetrieve playback metadata and playback state of media currently active on the Shield.\n</use_case>\n\n<important_notes>\n- Requires ADB connection established via `mcp-server-shieldtv adb-setup`.\n- position_s is null for live streaming TV.\n</important_notes>\n",
      "inputSchema": {
        "properties": {},
        "title": "shield_get_now_playingArguments",
        "type": "object"
      },
      "name": "shield_get_now_playing",
      "outputSchema": {
        "properties": {
          "app": {
