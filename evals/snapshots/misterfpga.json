          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "host",
          "outcome",
          "detail",
          "warnings"
        ],
        "title": "Outcome",
        "type": "object"
      }
    },
