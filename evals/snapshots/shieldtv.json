      "description": "Launch an application on the Shield TV.\n\n<use_case>\nLaunch streaming media apps (e.g. Netflix, YouTube, Plex) by friendly name.\n</use_case>\n\n<important_notes>\n- Video output requires Onkyo AVR input set to 'strm-box' and TV input set to AVR HDMI port.\n- Confirms that the application is running in the foreground before returning.\n- Unknown app names suggest closest matches from configured apps.\n</important_notes>\n",
      "inputSchema": {
        "properties": {
          "app": {
            "description": "Friendly app name from shield_list_apps, e.g. 'netflix'.",
            "title": "App",
            "type": "string"
          }
        },
        "required": [
          "app"
        ],
        "title": "shield_launch_appArguments",
        "type": "object"
      },
      "name": "shield_launch_app",
      "outputSchema": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "done",
              "unchanged",
              "dry_run"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "sent": {
            "items": {
              "type": "string"
            },
            "title": "Sent",
            "type": "array"
          },
          "shield": {
            "title": "Shield",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "shield",
          "outcome",
          "detail",
          "sent",
          "warnings"
        ],
        "title": "ActionResult",
        "type": "object"
      }
    },
